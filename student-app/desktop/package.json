{
  "name": "poly-ai-demo",
  "version": "1.0.0",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "npm run build:renderer",
    "build:renderer": "cd renderer && webpack --mode production",
    "build:dev": "cd renderer && webpack --mode development",
    "build:backend": "../scripts/build_backend.sh",
    "dist": "npm run build:renderer && npm run build:backend && electron-builder",
    "dist:mac": "npm run dist -- --mac",
    "dist:win": "npm run dist -- --win",
    "dist:linux": "npm run dist -- --linux"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "antd": "^5.28.0",
    "buffer": "^6.0.3",
    "dayjs": "^1.11.19",
    "electron-log": "^5.0.1",
    "electron-updater": "^6.1.7",
    "process": "^0.11.10",
    "react-markdown": "^9.1.0",
    "react-syntax-highlighter": "^15.6.6",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.25.0",
    "babel-loader": "^9.1.0",
    "css-loader": "^7.1.2",
    "electron": "^30.5.1",
    "electron-builder": "^24.9.1",
    "less": "^4.4.2",
    "less-loader": "^12.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "appId": "com.fpt.ai-personalized-learning",
    "productName": "AI Personalized Learning",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "src/**/*",
      "index.html",
      "package.json",
      "!**/*.py",
      "!**/*.pyc",
      "!**/__pycache__/**"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/ai-learning-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../model_packages",
        "to": "backend/model_packages",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icons/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/icons/icon.icns",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icons/icon.png",
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
